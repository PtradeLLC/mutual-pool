rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Users ----------
    match /users/{userId} {
      allow read, write: if true;
    }

    // ---------- Pods ----------
    match /pods/{podId} {
      allow read, write: if true;
    }

    // ---------- Perks Marketplace ----------
    match /perks/{perkId} {
      allow read, write: if true;
    }

    // ---------- Audit Logs ----------
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // ---------- Hardship Requests ----------
    match /hardshipRequests/{requestId} {
      allow read, write: if true;
    }

    // ---------- Redemptions ----------
    match /redemptions/{redemptionId} {
      allow read, write: if true;
    }

    // ---------- Fallback ----------
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
