rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /pods/{podId} {
      allow read, write: if true;
    }
    match /perks/{perkId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
    match /hardshipRequests/{requestId} {
      allow read, write: if true;
    }
    match /redemptions/{redemptionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
