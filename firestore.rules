rules_version = '2';

// The Node server (Firebase Admin SDK, which bypasses these rules) is the only
// writer and the source of truth for all application data. Browsers read and
// change data through the authenticated /api endpoints.
//
// The client may only read its own user document (live balance/profile
// updates). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
