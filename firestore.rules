rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'chrisbitoy@gmail.com' ||
        (request.auth.token.role != null && request.auth.token.role == 'Admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Pods Collection
    match /pods/{podId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(podId);
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Perks Collection
    match /perks/{perkId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(perkId);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.submittedBy == request.auth.uid ||
        request.auth.uid == request.resource.data.submittedBy
      );
      allow delete: if isAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(logId);
      allow update, delete: if false;
    }

    // Redemptions Collection
    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && 
                    isValidId(redemptionId) && 
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Swap Requests Collection
    match /swap_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(requestId);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.requesterUserId == request.auth.uid || isAdmin()
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}


