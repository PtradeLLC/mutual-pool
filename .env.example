# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# NODE_ENV=production is set by the Dockerfile / `npm start`. In production the
# server refuses to start unless the required variables below are set.
# PORT=8080

# APP_URL: public origin of the app (Stripe redirect URLs, CORS allowlist).
APP_URL="https://themutualpool.com"
# Optional extra origins allowed to call the API cross-origin (comma-separated).
# ALLOWED_ORIGINS=""

# DEMO_MODE: development only (ignored and rejected in production). Re-enables
# simulated sign-in via x-user-* headers, simulated KYC, direct top-ups and seed
# data for local demos and the integration tests. Use `npm run dev:demo`.
# DEMO_MODE="true"
# VITE_DEMO_MODE="true"   # matching client-side flag (dev builds only)

# TREASURY_ENABLED / VITE_TREASURY_ENABLED: set both to "true" ONLY once member
# funds are held in Stripe Treasury financial accounts (Stripe Treasury access
# approved and integrated). Until then every FDIC / pass-through insurance claim
# in the app is replaced with neutral "payments processed by Stripe" wording.
TREASURY_ENABLED="false"
VITE_TREASURY_ENABLED="false"

# ---------------------------------------------------------------------------
# Payout-then-default controls
# ---------------------------------------------------------------------------
# Both rules live in src/server/rotation.ts and share one line: $1,000.
# - Join cap ladder: a member may join pots up to $1,000 before their first
#   cleanly completed pod, then $2,500, $5,000, and any size from the third.
# - Early slots by trust: the first half of a rotation goes to members with
#   completed pods, then members with this many days on MutualPool, then new
#   members who have authorized bank debits. Pots over $1,000 can't lock until
#   every early slot can be held by a seasoned member; smaller pots always lock.
# EARLY_SLOT_TENURE_DAYS="90"
# Members must authorize bank debits (Stripe ACH mandate) before creating or
# joining a pod. Admins recover missed deposits through it from Admin Ops.
# DEBIT_MANDATE_REQUIRED="true"

# CRON_SECRET: lets an external scheduler (e.g. Cloud Scheduler) trigger the
# weekly sweeps with the x-cron-secret header:
#   POST /api/platform/schedule/sweep  {"sweepType":"THURSDAY_DEPOSITS"}  Thu 00:05
#   POST /api/platform/schedule/sweep  {"sweepType":"FRIDAY_PAYOUTS"}    Fri 00:05
# The server also schedules them itself and catches up after downtime; runs are
# recorded per settlement week so the two never double-run. Set TZ for the
# promised local time (the Dockerfile uses America/New_York).
CRON_SECRET=""

# Default controls (src/server/defaultControls.ts). Hours a member has to pay a
# missed deposit after the notice before they are removed from the pod, their
# account is restricted and ACH collection starts (default 24); and how long a
# pod pause vote stays open (default 48).
DEFAULT_REMOVAL_GRACE_HOURS="24"
POD_PAUSE_VOTE_HOURS="48"

# ---------------------------------------------------------------------------
# Custody: where member money sits (src/server/custody.ts)
#   ledger - in-memory ledger only (default; nothing moves at a bank)
#   column - every member, pod and platform balance is a real bank account at
#            Column (column.com); ledger moves settle as Column book transfers
# ---------------------------------------------------------------------------
CUSTODY_PROVIDER="ledger"
# Column API key: test_... (sandbox) or live_... (production). The prefix
# selects the environment.
COLUMN_API_KEY=""
# Signing secret of the Column webhook endpoint pointing at /api/webhooks/column
# (events: ach.*, book.*, identity.*).
COLUMN_WEBHOOK_SECRET=""
# Production only: the platform entity and its three accounts. In the sandbox
# they are created automatically on first use.
COLUMN_PLATFORM_ENTITY_ID=""
COLUMN_OPERATING_ACCOUNT_ID=""
COLUMN_ESCROW_ACCOUNT_ID=""
COLUMN_REVENUE_ACCOUNT_ID=""

# ---------------------------------------------------------------------------
# Email (Resend) — invitations, missed-deposit and bank-debit notices, support
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY every message is queued (visible in Admin Ops health)
# but nothing is sent. EMAIL_FROM must be a verified sender on the domain.
RESEND_API_KEY=""
EMAIL_FROM="MutualPool <no-reply@themutualpool.com>"
# Where the contact form and support notices go; also printed in the Terms.
SUPPORT_EMAIL="support@themutualpool.com"
VITE_SUPPORT_EMAIL="support@themutualpool.com"

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Incoming webhook (Slack/Discord/PagerDuty-style) that receives error and
# critical incidents: failed sweeps, webhook failures, money movements that
# need manual review, card reversals. Admins also see them in /api/health.
ALERT_WEBHOOK_URL=""
# Hard cap on AI (gear verification / voice) calls per day across all users.
# AI_DAILY_CALL_BUDGET="5000"
# State whose law governs the Terms (shown in /terms). Confirm with counsel.
# GOVERNING_LAW_STATE="Delaware"
# VITE_GOVERNING_LAW_STATE="Delaware"

# ---------------------------------------------------------------------------
# Firebase Auth (server: Admin SDK verifies sign-in tokens)  [required in production]
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
# Service account JSON (single line). Optional for the server (token
# verification only needs the project id); required by scripts/set-admin-claim.ts.
FIREBASE_SERVICE_ACCOUNT=""

# ---------------------------------------------------------------------------
# Database (src/server/storage)  [required in production]
# ---------------------------------------------------------------------------
# "postgres" (default): any Postgres via DATABASE_URL. On Fly, `fly postgres
# attach` sets DATABASE_URL automatically (internal network, no TLS). For an
# external Postgres that requires TLS, add ?sslmode=require or DATABASE_SSL=true.
# "memory": in-process only, for tests. Production always persists; in
# development set PERSIST_STATE=true to use the database instead of JSON files.
STORAGE_BACKEND="postgres"
DATABASE_URL=""
# PERSIST_STATE="true"

# Firebase (client, inlined at build time)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ---------------------------------------------------------------------------
# Stripe  [required in production]
# ---------------------------------------------------------------------------
# Deposits use Stripe Checkout; identity + payout bank accounts use Connect
# onboarding; withdrawals are transfers to the member's connected account.
STRIPE_SECRET_KEY=""
# Webhook endpoint: https://<APP_URL>/api/webhooks/stripe
# Account webhook events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, payment_intent.succeeded,
#   payment_intent.payment_failed, payment_intent.canceled,
#   setup_intent.succeeded, setup_intent.setup_failed, setup_intent.canceled,
#   mandate.updated, charge.dispute.created, charge.refunded
STRIPE_WEBHOOK_SECRET=""
# Connect webhook (same URL, "Listen to events on Connected accounts"):
#   account.updated. It has its own signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# AI (Gemini / Groq)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ---------------------------------------------------------------------------
# Fourthwall print-on-demand (https://docs.fourthwall.com/quickstart)
# ---------------------------------------------------------------------------
FOURTHWALL_API_URL="https://platform.fourthwall.com/v1"
FOURTHWALL_API_KEY=""
FOURTHWALL_SHOP_ID=""
FOURTHWALL_STOREFRONT_TOKEN=""
# Signing secret for /api/fourthwall/webhook (X-Fourthwall-Hmac-SHA256 header).
FOURTHWALL_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Site URLs (client)
# ---------------------------------------------------------------------------
VITE_DEV_URL="https://mutual-pool.vercel.app"
VITE_PROD_URL="https://themutualpool.com"
# VITE_SITE_URL="https://themutualpool.com"
# VITE_APP_ENV="production"

# Ad video generation (npm run video:ad) - Runway developer API key from dev.runwayml.com
RUNWAY_API_KEY=
# Optional narrator preset for the ad (Runway eleven_v3 preset name, default Kendrick)
AD_VOICE_PRESET=
